{
 "align_labels_right": 0,
 "creation": "2026-02-20 00:00:00.000000",
 "custom_format": 1,
 "doc_type": "LPG Bulk Price Upload",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div style=\"font-family: Inter, Arial, sans-serif; font-size: 11px; color: #1d1d1f;\">\n  <div style=\"display: flex; justify-content: space-between; border-bottom: 2px solid #1d1d1f; padding-bottom: 8px; margin-bottom: 12px;\">\n    <div>\n      <div style=\"font-size: 18px; font-weight: 700; letter-spacing: 0.5px;\">LPG BULK PRICE UPLOAD</div>\n      <div style=\"font-size: 10px; color: #6e6e73;\">Sungas Pricing Governance &mdash; Pricing Wave B (P-3)</div>\n    </div>\n    <div style=\"text-align: right; font-size: 10px;\">\n      <div style=\"font-weight: 600; font-size: 14px;\">{{ doc.name }}</div>\n      <div>{{ frappe.format(doc.upload_date, {\"fieldtype\": \"Datetime\"}) }}</div>\n      <div>Status: <b>{{ doc.workflow_state or \"Draft\" }}</b></div>\n    </div>\n  </div>\n\n  <table style=\"width: 100%; font-size: 11px; margin-bottom: 14px; border-collapse: collapse;\">\n    <tr>\n      <td style=\"padding: 4px 8px; background:#f5f5f7; border:1px solid #e5e5ea; width:18%;\"><b>Uploaded By</b></td>\n      <td style=\"padding: 4px 8px; border:1px solid #e5e5ea; width:32%;\">{{ doc.uploader or \"&mdash;\" }}</td>\n      <td style=\"padding: 4px 8px; background:#f5f5f7; border:1px solid #e5e5ea; width:18%;\"><b>HoF Approver</b></td>\n      <td style=\"padding: 4px 8px; border:1px solid #e5e5ea; width:32%;\">\n        {{ doc.approved_by_finance or \"(pending)\" }}\n        {% if doc.finance_approved_on %}<br><span style=\"color:#6e6e73; font-size:10px;\">on {{ frappe.format(doc.finance_approved_on, {\"fieldtype\": \"Datetime\"}) }}</span>{% endif %}\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 8px; background:#f5f5f7; border:1px solid #e5e5ea;\"><b>Total Rows</b></td>\n      <td style=\"padding: 4px 8px; border:1px solid #e5e5ea;\">{{ doc.total_rows or 0 }}</td>\n      <td style=\"padding: 4px 8px; background:#f5f5f7; border:1px solid #e5e5ea;\"><b>Flagged Rows</b></td>\n      <td style=\"padding: 4px 8px; border:1px solid #e5e5ea; color: {% if (doc.flagged_rows or 0) > 0 %}#c00{% else %}#1d1d1f{% endif %};\"><b>{{ doc.flagged_rows or 0 }}</b></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 4px 8px; background:#f5f5f7; border:1px solid #e5e5ea;\"><b>Max |&Delta;%|</b></td>\n      <td style=\"padding: 4px 8px; border:1px solid #e5e5ea;\">{{ \"{:.2f}\".format(doc.max_pct_change or 0) }}%</td>\n      <td style=\"padding: 4px 8px; background:#f5f5f7; border:1px solid #e5e5ea;\"><b>Description</b></td>\n      <td style=\"padding: 4px 8px; border:1px solid #e5e5ea;\">{{ doc.description or \"&mdash;\" }}</td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 10px;\">\n    <thead>\n      <tr style=\"background: #1d1d1f; color: #fff;\">\n        <th style=\"padding: 6px; text-align: left; width: 4%;\">#</th>\n        <th style=\"padding: 6px; text-align: left; width: 18%;\">Item</th>\n        <th style=\"padding: 6px; text-align: left; width: 12%;\">Group</th>\n        <th style=\"padding: 6px; text-align: left; width: 16%;\">Territory</th>\n        <th style=\"padding: 6px; text-align: right; width: 10%;\">Old Rate</th>\n        <th style=\"padding: 6px; text-align: right; width: 10%;\">New Rate</th>\n        <th style=\"padding: 6px; text-align: right; width: 8%;\">&Delta;%</th>\n        <th style=\"padding: 6px; text-align: center; width: 7%;\">Flag</th>\n        <th style=\"padding: 6px; text-align: left; width: 15%;\">Justification</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.rows %}\n      <tr style=\"background: {% if row.flag_status == 'Flagged' %}#fff5e6{% elif loop.index0 % 2 == 0 %}#fafafa{% else %}#ffffff{% endif %};\">\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea;\">{{ loop.index }}</td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea;\"><b>{{ row.item_code }}</b><br><span style=\"color:#6e6e73; font-size:9px;\">{{ row.item_name or \"\" }}</span></td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea;\">{{ row.customer_group }}</td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea;\">{{ row.territory or \"<i>GLOBAL</i>\" }}</td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea; text-align: right;\">{{ \"{:,.2f}\".format(row.current_rate or 0) }}</td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea; text-align: right;\"><b>{{ \"{:,.2f}\".format(row.new_rate or 0) }}</b></td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea; text-align: right; color: {% if (row.pct_change or 0) > 0 %}#c00{% elif (row.pct_change or 0) < 0 %}#070{% endif %};\">{{ \"{:+.2f}\".format(row.pct_change or 0) }}%</td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea; text-align: center;\">\n          {% if row.flag_status == 'Flagged' %}<span style=\"background:#c00; color:#fff; padding:1px 5px; border-radius:3px; font-size:9px;\">FLAG</span>{% else %}<span style=\"color:#070;\">OK</span>{% endif %}\n        </td>\n        <td style=\"padding: 5px; border-bottom: 1px solid #e5e5ea; font-size: 9px;\">{{ row.justification or \"&mdash;\" }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"margin-top: 24px; display: flex; justify-content: space-between;\">\n    <div style=\"width: 45%; border-top: 1px solid #1d1d1f; padding-top: 6px; font-size: 10px;\">\n      <b>Uploaded by</b> &mdash; Head of Sales<br>\n      {{ doc.uploader or \"\" }}<br>\n      {{ frappe.format(doc.upload_date, {\"fieldtype\": \"Datetime\"}) }}\n    </div>\n    <div style=\"width: 45%; border-top: 1px solid #1d1d1f; padding-top: 6px; font-size: 10px;\">\n      <b>Approved by</b> &mdash; Head of Finance<br>\n      {{ doc.approved_by_finance or \"___________________________\" }}<br>\n      {% if doc.finance_approved_on %}{{ frappe.format(doc.finance_approved_on, {\"fieldtype\": \"Datetime\"}) }}{% else %}_________________________{% endif %}\n    </div>\n  </div>\n</div>",
